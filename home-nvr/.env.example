# Copy to .env (setup.sh does this for you) and fill in. Never commit .env.

# Timezone for timestamps in the UI, e.g. Australia/Sydney, Europe/London, America/Chicago
TZ=Etc/UTC

# Where recordings are written. Point this at the big drive, e.g. /mnt/nvr
STORAGE_PATH=./storage

# Frigate image tag. "stable" follows the latest release; pin a version (e.g. 0.18.2)
# if you prefer to upgrade deliberately.
FRIGATE_IMAGE_TAG=stable

# Camera login, referenced from config/config.yml as {FRIGATE_RTSP_USER} and
# {FRIGATE_RTSP_PASSWORD}. Create the same viewer account on every camera.
# Avoid @ : / # ? in the password: they break stream URLs.
FRIGATE_RTSP_USER=nvr
FRIGATE_RTSP_PASSWORD=change-me
